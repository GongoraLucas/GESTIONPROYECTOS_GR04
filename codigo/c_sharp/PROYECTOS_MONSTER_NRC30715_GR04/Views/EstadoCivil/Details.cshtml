@model PROYECTOS_MONSTER_NRC30715_GR04.Models.ViewModels.EstadoCivilViewModel

@{
    ViewData["Title"] = "Detalle Estado Civil";
}

<h3 class="mb-4">Detalle Estado Civil</h3>

<div class="card mb-4">
    <div class="card-body">
        <table class="table table-bordered">
            <tr>
                <th width="30%">Código</th>
                <td>@Model.Codigo</td>
            </tr>
            <tr>
                <th>Descripción</th>
                <td>@Model.Descripcion</td>
            </tr>
        </table>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
