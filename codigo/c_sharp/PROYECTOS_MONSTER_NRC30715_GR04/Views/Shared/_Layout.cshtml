<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Monster Projects
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/PROYECTOS_MONSTER_NRC30715_GR04.styles.css"
          asp-append-version="true" />
</head>

@using System.Security.Claims

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">

            <div class="container-fluid">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    Monster Projects
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMain">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="navbarMain">

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <ul class="navbar-nav me-auto">

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Dashboard
                                </a>

                            </li>

                            @if (User.Claims.Any(
                           x => x.Type == "OPCION" &&
                                x.Value == "USR"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Usuario"
                                       asp-action="Index">
                                        Usuarios
                                    </a>

                                </li>
                            }

                            @if (User.Claims.Any(
                           x => x.Type == "OPCION" &&
                                x.Value == "EMP"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Empleado"
                                       asp-action="Index">
                                        Empleados
                                    </a>

                                </li>
                            }

                            @if (User.Claims.Any(
                           x => x.Type == "OPCION" &&
                                x.Value == "PRO"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Proyecto"
                                       asp-action="Index">
                                        Proyectos
                                    </a>

                                </li>
                            }

                            @if (User.Claims.Any(
                           x => x.Type == "OPCION" &&
                                x.Value == "REP"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Reporte"
                                       asp-action="Index">
                                        Reportes
                                    </a>

                                </li>
                            }

                            @if (User.Claims.Any(x =>
                                x.Type == "OPCION" &&
                                x.Value == "USR"))
                            {
                                <li class="nav-item dropdown">

                                    <a class="nav-link dropdown-toggle"
                                       href="#"
                                       data-bs-toggle="dropdown">

                                        Seguridad

                                    </a>

                                    <ul class="dropdown-menu">

                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Seguridad"
                                               asp-action="AsignarUsuarioPerfil">

                                                Usuario - Perfil

                                            </a>

                                        </li>

                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Seguridad"
                                               asp-action="AsignarOpcionPerfil">

                                                Perfil - Opción

                                            </a>

                                        </li>

                                    </ul>

                                </li>
                            }

                            @if (User.Claims.Any(x =>
                                x.Type == "OPCION" &&
                                x.Value == "EMP"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Empleado"
                                       asp-action="Index">

                                        Empleados

                                    </a>

                                </li>
                            }

                        </ul>

                        <div class="d-flex align-items-center">

                            <span class="text-white me-3">
                                @User.Identity.Name
                            </span>

                            <a asp-controller="Account"
                               asp-action="CambiarPassword"
                               class="btn btn-warning btn-sm me-2">

                                Contraseña

                            </a>

                            <a asp-controller="Account"
                               asp-action="Logout"
                               class="btn btn-danger btn-sm">

                                Salir

                            </a>

                        </div>
                    }

                </div>

            </div>

        </nav>

    </header>

    <div class="container mt-4">

        <partial name="_Alerts" />

        <main role="main">

            @RenderBody()

        </main>

    </div>

    <footer class="border-top mt-5 py-3 text-center text-muted">

        <div class="container">

            &copy; 2026 - Monster Projects

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>