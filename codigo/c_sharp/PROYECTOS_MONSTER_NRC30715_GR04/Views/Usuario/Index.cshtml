@model List<PROYECTOS_MONSTER_NRC30715_GR04.Models.ViewModels.UsuarioItemViewModel>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<!-- Banner superior estilo Mockup con degradado celeste/azul -->
<div class="p-4 text-white rounded-4 shadow-sm mb-4 d-flex align-items-center gap-3" 
     style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);">
    <div class="bg-white bg-opacity-10 p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
        <i class="bi bi-people-fill" style="font-size: 1.8rem;"></i>
    </div>
    <div>
        <h2 class="fw-bold m-0" style="letter-spacing: -0.5px; font-family: 'Outfit', sans-serif;">Gestión de Usuarios</h2>
        <p class="m-0 text-white-50 mt-1" style="font-size: 0.95rem;">Administre las cuentas de acceso, perfiles asignados y restablecimiento de credenciales del sistema.</p>
    </div>
</div>

<!-- Barra de Búsqueda y Exportaciones -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <div class="row align-items-center g-3">
            <!-- Formulario Buscar -->
            <div class="col-md-7 col-lg-8">
                <form method="get" asp-action="Index" class="d-flex gap-2">
                    <div class="input-group rounded-pill bg-white shadow-xs" style="border: 1px solid #cbd5e1; overflow: hidden; flex: 1;">
                        <span class="input-group-text bg-transparent border-0 text-muted ps-3">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control border-0 ps-1 bg-transparent" placeholder="Buscar por usuario o correo..." style="box-shadow: none; padding: 10px;" />
                    </div>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-xs">Buscar</button>
                    @if (!string.IsNullOrEmpty(ViewBag.Buscar as string))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold">Limpiar</a>
                    }
                </form>
            </div>
            
            <!-- Descargar Reportes -->
            <div class="col-md-5 col-lg-4 d-flex justify-content-md-end gap-2">
                @if (User.Claims.Any(x => x.Type == "OPCION" && x.Value.StartsWith("REP_")))
                {
                    <a asp-action="ExportarPdf" class="btn btn-outline-danger rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-xs" title="Descargar PDF">
                        <i class="bi bi-file-earmark-pdf-fill"></i> PDF
                    </a>
                    <a asp-action="ExportarExcel" class="btn btn-outline-success rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-xs" title="Descargar Excel">
                        <i class="bi bi-file-earmark-excel-fill"></i> Excel
                    </a>
                    <a asp-action="ExportarCsv" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-xs" title="Descargar CSV">
                        <i class="bi bi-filetype-csv"></i> CSV
                    </a>
                }
                @if (User.Claims.Any(x => x.Type == "OPCION" && x.Value == "USR_CRE"))
                {
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm">
                        <i class="bi bi-person-plus-fill"></i> Nuevo
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Resultados -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom" style="--bs-table-bg: #f8fafc; border-color: #e2e8f0 !important;">
                    <tr>
                        <th class="ps-4 py-3 text-secondary fw-bold text-uppercase fs-7" style="width: 35%;">Usuario (Login)</th>
                        <th class="py-3 text-secondary fw-bold text-uppercase fs-7" style="width: 35%;">Perfiles Asignados</th>
                        <th class="text-end pe-4 py-3 text-secondary fw-bold text-uppercase fs-7" style="width: 30%;">Acciones</th>
                    </tr>
                </thead>
                <tbody style="border-top: none;">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-opacity-25"></i>
                                No existen registros que coincidan con la búsqueda.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3.5">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-circle">
                                            @item.Login.Substring(0, Math.Min(2, item.Login.Length)).ToUpper()
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark block">@item.Login</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5">
                                    @if (item.Perfiles != null && item.Perfiles.Any())
                                    {
                                        foreach (var perfil in item.Perfiles)
                                        {
                                            <span class="badge bg-light text-dark border me-1 mb-1 fw-semibold" 
                                                  style="border-color: #cbd5e1 !important; font-size: 0.8rem; padding: 0.4rem 0.75rem; border-radius: 30px; display: inline-flex; align-items: center; box-shadow: 0 1px 2px rgba(0,0,0,0.01);">
                                                <i class="bi bi-shield-check text-primary me-1"></i>@perfil
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted font-italic small"><i class="bi bi-slash-circle me-1"></i>Sin perfiles asignados</span>
                                    }
                                </td>
                                <td class="text-end pe-4 py-3.5">
                                    <div class="d-inline-flex gap-2">
                                        <!-- Botón Restablecer Password por Admin -->
                                        @if (User.Claims.Any(x => x.Type == "OPCION" && x.Value == "USR_PWD"))
                                        {
                                            <form asp-action="RestablecerPasswordAdmin" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro de restablecer la contraseña del usuario \'@item.Login\' a la contraseña temporal \'Temp1234\'?');">
                                                <input type="hidden" name="usuarioId" value="@item.Id" />
                                                <button type="submit" class="btn btn-outline-info rounded-pill btn-sm px-3 d-inline-flex align-items-center gap-1 fw-semibold" title="Restablecer Contraseña">
                                                    <i class="bi bi-key-fill"></i> <span class="d-none d-lg-inline">Restablecer Pwd</span>
                                                </button>
                                            </form>
                                        }

                                        @if (User.Claims.Any(x => x.Type == "OPCION" && x.Value == "USR_UPD"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning rounded-pill btn-sm px-3 d-inline-flex align-items-center gap-1 fw-semibold" title="Editar">
                                                <i class="bi bi-pencil-square"></i> <span class="d-none d-lg-inline">Editar</span>
                                            </a>
                                        }

                                        @if (User.Claims.Any(x => x.Type == "OPCION" && x.Value == "USR_DEL"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger rounded-pill btn-sm px-3 d-inline-flex align-items-center gap-1 fw-semibold" title="Eliminar">
                                                <i class="bi bi-trash"></i> <span class="d-none d-lg-inline">Eliminar</span>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Paginación Estilizada -->
@if (ViewBag.TotalPaginas > 1)
{
    <nav aria-label="Navegación de páginas" class="d-flex justify-content-center mt-4 mb-3">
        <ul class="pagination pagination-sm shadow-xs rounded-pill border overflow-hidden bg-white" style="border-radius: 30px !important;">
            <li class="page-item @(ViewBag.Pagina == 1 ? "disabled" : "")">
                <a class="page-link border-0 px-3 py-2 bg-transparent text-secondary" asp-action="Index" asp-route-buscar="@ViewBag.Buscar" asp-route-pagina="@(ViewBag.Pagina - 1)">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                <li class="page-item @(ViewBag.Pagina == i ? "active" : "")">
                    <a class="page-link border-0 px-3.5 py-2 @(ViewBag.Pagina == i ? "bg-primary text-white" : "bg-transparent text-dark")" 
                       asp-action="Index" asp-route-buscar="@ViewBag.Buscar" asp-route-pagina="@i">@i</a>
                </li>
            }
            <li class="page-item @(ViewBag.Pagina == ViewBag.TotalPaginas ? "disabled" : "")">
                <a class="page-link border-0 px-3 py-2 bg-transparent text-secondary" asp-action="Index" asp-route-buscar="@ViewBag.Buscar" asp-route-pagina="@(ViewBag.Pagina + 1)">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}

<style>
    .avatar-circle {
        width: 36px;
        height: 36px;
        background-color: rgba(2, 132, 199, 0.1);
        color: #0284c7;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        font-weight: 700;
        border: 1px solid rgba(2, 132, 199, 0.15);
    }
    .py-3\.5 {
        padding-top: 0.85rem !important;
        padding-bottom: 0.85rem !important;
    }
    .fs-7 {
        font-size: 0.8rem;
    }
    .pagination .page-item.disabled .page-link {
        color: #94a3b8 !important;
        background-color: transparent !important;
    }
    .pagination .page-link:focus {
        box-shadow: none;
    }
</style>
