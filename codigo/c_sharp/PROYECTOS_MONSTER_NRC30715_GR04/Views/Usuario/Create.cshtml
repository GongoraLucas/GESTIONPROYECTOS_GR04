@model PROYECTOS_MONSTER_NRC30715_GR04.Models.ViewModels.UsuarioViewModel

@{
    ViewData["Title"] = "Nuevo Usuario";
}

<style>
    /* Estilos estéticos de Stripe para los inputs */
    .form-label-custom {
        font-size: 13px;
        font-weight: 600;
        color: #4f566b;
        margin-bottom: 6px;
    }
    .form-control-custom, .form-select-custom {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        font-size: 14px;
        color: #1a1f36;
        background-color: #f8fafc;
        outline: none;
        transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .form-control-custom:focus, .form-select-custom:focus {
        background-color: #ffffff;
        border-color: #cbd5e1;
        box-shadow: 0 0 0 4px rgba(99, 91, 255, 0.1);
    }
    .input-group-text-custom {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-right: none;
        border-radius: 10px 0 0 10px;
        color: #64748b;
        padding-left: 16px;
        padding-right: 12px;
    }
    .input-group-custom .form-control-custom {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
    }
    .btn-toggle-custom {
        border: 1px solid #e2e8f0;
        border-left: none;
        background-color: #f8fafc;
        color: #64748b;
        border-radius: 0 10px 10px 0;
        padding: 12px 16px;
        transition: background-color 0.15s ease;
    }
    .btn-toggle-custom:hover {
        background-color: #f1f5f9;
        color: #1a1f36;
    }
</style>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-person-plus text-primary fs-3"></i>
        <h3 class="m-0 fw-bold" style="font-family: 'Outfit', sans-serif;">Crear Nuevo Usuario</h3>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-xs">
        <i class="bi bi-arrow-left"></i> Volver a la Lista
    </a>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-4 p-md-5">
        <form asp-action="Create" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

            <div class="row g-4">
                <!-- Username (Login) -->
                <div class="col-md-6">
                    <label asp-for="Login" class="form-label-custom">Nombre de Usuario (Login)</label>
                    <div class="input-group input-group-custom">
                        <span class="input-group-text-custom d-flex align-items-center"><i class="bi bi-person"></i></span>
                        <input asp-for="Login" class="form-control-custom" placeholder="Ej. cgomez" required maxlength="50" />
                    </div>
                    <span asp-validation-for="Login" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Email Address -->
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label-custom">Correo Electrónico</label>
                    <div class="input-group input-group-custom">
                        <span class="input-group-text-custom d-flex align-items-center"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" type="email" class="form-control-custom" placeholder="Ej. carlos.gomez@monster.com" required maxlength="100" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Associated Employee -->
                <div class="col-md-6">
                    <label asp-for="EmpleadoCodigo" class="form-label-custom">Empleado Asociado</label>
                    <div class="input-group input-group-custom">
                        <span class="input-group-text-custom d-flex align-items-center"><i class="bi bi-person-badge"></i></span>
                        <select asp-for="EmpleadoCodigo" asp-items="Model.Empleados" class="form-select-custom" required style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                            <option value="">-- Seleccione el Empleado --</option>
                        </select>
                    </div>
                    <span asp-validation-for="EmpleadoCodigo" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Initial Status -->
                <div class="col-md-6">
                    <label asp-for="EstadoCodigo" class="form-label-custom">Estado de la Cuenta</label>
                    <div class="input-group input-group-custom">
                        <span class="input-group-text-custom d-flex align-items-center"><i class="bi bi-toggle-on"></i></span>
                        <select asp-for="EstadoCodigo" asp-items="Model.Estados" class="form-select-custom" required style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                            <option value="">-- Seleccione el Estado --</option>
                        </select>
                    </div>
                    <span asp-validation-for="EstadoCodigo" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Password -->
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label-custom">Contraseña Inicial</label>
                    <div class="input-group input-group-custom">
                        <span class="input-group-text-custom d-flex align-items-center" style="border-radius: 10px 0 0 10px;"><i class="bi bi-key"></i></span>
                        <input asp-for="Password" type="password" class="form-control-custom" id="txt-password" placeholder="Establezca la contraseña inicial..." required minlength="6" maxlength="50" autocomplete="new-password" style="border-radius: 0;" />
                        <button class="btn-toggle-custom d-flex align-items-center justify-content-center" type="button" id="btn-toggle-pwd">
                            <i class="bi bi-eye" id="toggle-icon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    <small class="text-muted mt-2 d-block"><i class="bi bi-info-circle me-1"></i>Mínimo 6 caracteres. El usuario deberá cambiarla obligatoriamente en su primer ingreso.</small>
                </div>
            </div>

            <hr class="my-4 text-muted opacity-25" />

            <!-- Acciones -->
            <div class="d-flex gap-3 justify-content-end">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">Cancelar</a>
                <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-check-circle-fill"></i> Crear Cuenta
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const btnToggle = document.getElementById("btn-toggle-pwd");
            const txtPwd = document.getElementById("txt-password");
            const icon = document.getElementById("toggle-icon");

            if (btnToggle && txtPwd && icon) {
                btnToggle.addEventListener("click", function () {
                    if (txtPwd.type === "password") {
                        txtPwd.type = "text";
                        icon.classList.remove("bi-eye");
                        icon.classList.add("bi-eye-slash");
                    } else {
                        txtPwd.type = "password";
                        icon.classList.remove("bi-eye-slash");
                        icon.classList.add("bi-eye");
                    }
                });
            }
        });
    </script>
}
