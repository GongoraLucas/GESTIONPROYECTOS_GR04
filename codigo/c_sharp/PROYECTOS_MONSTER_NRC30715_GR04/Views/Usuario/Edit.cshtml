@model PROYECTOS_MONSTER_NRC30715_GR04.Models.ViewModels.UsuarioViewModel

@{
    ViewData["Title"] = "Editar Usuario";
}

<h3>Editar Usuario</h3>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Login</label>
        <input asp-for="Login" class="form-control" />
        <span asp-validation-for="Login" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Empleado</label>
        <select asp-for="EmpleadoCodigo" asp-items="Model.Empleados" class="form-select">
            <option value="">-- Seleccionar --</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Estado</label>
        <select asp-for="EstadoCodigo" asp-items="Model.Estados" class="form-select">
            <option value="">-- Seleccionar --</option>
        </select>
    </div>

    <button class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
