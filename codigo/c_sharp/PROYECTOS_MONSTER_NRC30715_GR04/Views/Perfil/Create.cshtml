@model PROYECTOS_MONSTER_NRC30715_GR04.Models.Entities.Perfil

@{
    ViewData["Title"] = "Crear Perfil";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <!-- Back link -->
            <div class="mb-4">
                <a asp-action="Index" class="text-secondary text-decoration-none d-inline-flex align-items-center gap-1">
                    <i class="bi bi-arrow-left"></i> Volver al listado
                </a>
            </div>

            <!-- Form Card -->
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-white" style="font-family: 'Inter', sans-serif;">
                <h4 class="fw-bold text-dark mb-1" style="font-family: 'Outfit', sans-serif;">Crear Perfil de Seguridad</h4>
                <p class="text-secondary mb-4 fs-6">Define un nuevo rol con un código único para asociar usuarios y permisos.</p>

                <form asp-action="Create" method="post" id="createProfileForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Código Input -->
                    <div class="mb-3">
                        <label asp-for="Codigo" class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">Código del Perfil</label>
                        <input asp-for="Codigo" class="form-control text-uppercase px-3 py-2 border-slate" 
                               maxlength="8" required placeholder="Ej. ADMIN" style="border-radius: 6px;" />
                        <span asp-validation-for="Codigo" class="text-danger font-sm mt-1 d-block" style="font-size: 0.8rem;"></span>
                        <div class="form-text mt-1 text-muted" style="font-size: 0.75rem;">Máximo 8 caracteres alfanuméricos. Se guardará en mayúsculas.</div>
                    </div>

                    <!-- Descripción Input -->
                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">Descripción</label>
                        <input asp-for="Descripcion" class="form-control px-3 py-2 border-slate" 
                               maxlength="100" required placeholder="Ej. Administrador del Sistema" style="border-radius: 6px;" />
                        <span asp-validation-for="Descripcion" class="text-danger font-sm mt-1 d-block" style="font-size: 0.8rem;"></span>
                    </div>

                    <!-- Observación Input -->
                    <div class="mb-4">
                        <label asp-for="Observacion" class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">Observaciones (Opcional)</label>
                        <textarea asp-for="Observacion" class="form-control px-3 py-2 border-slate" rows="3" 
                                  placeholder="Detalle o justificación de este perfil..." style="border-radius: 6px; resize: none;"></textarea>
                        <span asp-validation-for="Observacion" class="text-danger font-sm mt-1 d-block" style="font-size: 0.8rem;"></span>
                    </div>

                    <!-- Form Buttons -->
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-light border px-4 py-2 text-dark font-medium" style="border-radius: 6px;">
                            Cancelar
                        </a>
                        <button type="submit" class="btn text-white px-4 py-2 font-medium" style="background-color: #635bff; border-radius: 6px;">
                            Crear Perfil
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .border-slate {
        border: 1px solid #cbd5e1;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .border-slate:focus {
        border-color: #635bff !important;
        box-shadow: 0 0 0 4px rgba(99, 91, 255, 0.1) !important;
        outline: none;
    }
</style>
