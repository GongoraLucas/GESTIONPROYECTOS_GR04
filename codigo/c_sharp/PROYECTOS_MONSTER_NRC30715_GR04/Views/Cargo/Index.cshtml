@model List<PROYECTOS_MONSTER_NRC30715_GR04.Models.ViewModels.CargoViewModel>

@{
    ViewData["Title"] = "Cargos";
}

<!-- Banner superior estilo Mockup -->
<div class="p-4 text-white rounded-4 shadow-sm mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3" 
     style="background: linear-gradient(135deg, #2b70c9 0%, #1e457e 100%);">
    <div class="d-flex align-items-center gap-3">
        <div class="bg-white bg-opacity-10 p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
            <i class="bi bi-briefcase-fill" style="font-size: 1.8rem;"></i>
        </div>
        <div>
            <h2 class="fw-bold m-0" style="letter-spacing: -0.5px;">Módulo de Cargos</h2>
            <p class="m-0 text-white-50 mt-1" style="font-size: 0.95rem;">Gestione los cargos, puestos de trabajo y responsabilidades de la organización.</p>
        </div>
    </div>
    @if (User.Claims.Any(x => x.Type == "OPCION" && x.Value == "CAR_CRE"))
    {
        <a asp-action="Create" class="btn btn-light text-primary rounded-pill px-4 py-2-5 fw-semibold shadow-sm d-inline-flex align-items-center gap-2" 
           style="color: #0d6efd !important; border: none; font-size: 0.95rem;">
            <i class="bi bi-plus-lg"></i> Nuevo Cargo
        </a>
    }
</div>

<!-- Card principal -->
<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-4">
        
        <!-- Fila de Cabecera del Listado -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div class="d-flex align-items-center">
                <h4 class="fw-bold text-dark m-0" style="font-size: 1.25rem;">Cargos Registrados</h4>
                <span class="badge rounded-pill px-3 py-2 ms-3 fw-bold" 
                      style="font-size: 0.8rem; background-color: #2563eb !important;">Total: @(ViewBag.TotalRegistros ?? Model.Count)</span>
            </div>
            
            <!-- Botones de Reporte (Exportación) -->
            <div>
                @if (User.Claims.Any(x => x.Type == "OPCION" && x.Value == "REP_CAR"))
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small fw-semibold me-2">Exportar:</span>
                        <a asp-action="ExportarPdf" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 px-3 py-2 rounded-pill shadow-xs" title="Exportar a PDF">
                            <i class="bi bi-file-earmark-pdf-fill"></i> PDF
                        </a>
                        <a asp-action="ExportarExcel" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1 px-3 py-2 rounded-pill shadow-xs" title="Exportar a Excel">
                            <i class="bi bi-file-earmark-excel-fill"></i> Excel
                        </a>
                        <a asp-action="ExportarCsv" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 px-3 py-2 rounded-pill shadow-xs" title="Exportar a CSV">
                            <i class="bi bi-filetype-csv"></i> CSV
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Buscador -->
        <form method="get" asp-action="Index" class="row g-2 mb-4">
            <div class="col-md-9 col-lg-10">
                <div class="input-group shadow-xs rounded-pill" style="border: 1px solid #e2e8f0; overflow: hidden;">
                    <span class="input-group-text bg-white border-0 text-muted ps-3">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           name="buscar"
                           value="@ViewBag.Buscar"
                           class="form-control border-0 ps-0 bg-white"
                           placeholder="Buscar por departamento, código o descripción de cargo..." 
                           style="box-shadow: none;" />
                </div>
            </div>
            <div class="col-md-3 col-lg-2">
                <button type="submit" class="btn btn-dark w-100 rounded-pill shadow-sm py-2">
                    <i class="bi bi-funnel-fill me-1"></i> Filtrar
                </button>
            </div>
        </form>

        <!-- Tabla -->
        <div class="table-responsive">
            <table class="table align-middle" style="border-collapse: separate; border-spacing: 0 8px;">
                <thead>
                    <tr class="text-uppercase text-secondary font-monospace" style="font-size: 0.75rem; letter-spacing: 0.8px; border-bottom: 1px solid #f1f5f9;">
                        <th class="ps-3 border-0 pb-3">Departamento</th>
                        <th class="border-0 pb-3">Código de Cargo</th>
                        <th class="border-0 pb-3">Descripción</th>
                        <th class="text-end pe-3 border-0 pb-3" width="180">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5 border-0">
                                <i class="bi bi-info-circle fs-3 d-block mb-2 text-secondary"></i>
                                No se encontraron registros.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="shadow-xs rounded-3" style="background-color: #fff; border-bottom: 1px solid #f8fafc;">
                                <td class="ps-3 py-3 border-0" style="border-top-left-radius: 12px; border-bottom-left-radius: 12px;">
                                    <span class="badge bg-light text-dark border px-2.5 py-1.5 fw-semibold" style="border-color: #cbd5e1 !important; font-size: 0.8rem;">
                                        @item.DepartamentoDescripcion
                                    </span>
                                </td>
                                <td class="border-0 fw-semibold text-secondary">
                                    @item.Codigo
                                </td>
                                <td class="border-0 fw-semibold text-dark">
                                    @item.Descripcion
                                </td>
                                <td class="text-end pe-3 border-0" style="border-top-right-radius: 12px; border-bottom-right-radius: 12px;">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Details"
                                           asp-route-dep="@item.DepartamentoCodigo"
                                           asp-route-cod="@item.Codigo"
                                           class="btn btn-sm btn-outline-info d-inline-flex align-items-center justify-content-center"
                                           style="width: 38px; height: 38px; border-radius: 8px; border-color: #0dcaf0; color: #0dcaf0;"
                                           title="Ver Detalle">
                                            <i class="bi bi-eye" style="font-size: 0.95rem;"></i>
                                        </a>
                                        @if (User.Claims.Any(x => x.Type == "OPCION" && x.Value == "CAR_UPD"))
                                        {
                                            <a asp-action="Edit"
                                               asp-route-dep="@item.DepartamentoCodigo"
                                               asp-route-cod="@item.Codigo"
                                               class="btn btn-sm btn-outline-primary d-inline-flex align-items-center justify-content-center"
                                               style="width: 38px; height: 38px; border-radius: 8px; border-color: #3b82f6; color: #3b82f6;"
                                               title="Editar">
                                                <i class="bi bi-pencil" style="font-size: 0.95rem;"></i>
                                            </a>
                                        }
                                        @if (User.Claims.Any(x => x.Type == "OPCION" && x.Value == "CAR_DEL"))
                                        {
                                            <a asp-action="Delete"
                                               asp-route-dep="@item.DepartamentoCodigo"
                                               asp-route-cod="@item.Codigo"
                                               class="btn btn-sm btn-outline-danger d-inline-flex align-items-center justify-content-center"
                                               style="width: 38px; height: 38px; border-radius: 8px; border-color: #ef4444; color: #ef4444;"
                                               title="Eliminar">
                                                <i class="bi bi-trash" style="font-size: 0.95rem;"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPaginas > 1)
        {
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center border-top pt-4 mt-3 gap-2">
                <div class="text-muted small">
                    Página <strong>@ViewBag.PaginaActual</strong> de <strong>@ViewBag.TotalPaginas</strong>
                </div>
                <nav aria-label="Paginación de cargos">
                    <ul class="pagination pagination-sm m-0">
                        <li class="page-item @(ViewBag.PaginaActual <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(ViewBag.PaginaActual - 1)"
                               asp-route-buscar="@ViewBag.Buscar">
                                Anterior
                            </a>
                        </li>
                        @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                        {
                            <li class="page-item @(ViewBag.PaginaActual == i ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pagina="@i"
                                   asp-route-buscar="@ViewBag.Buscar">
                                    @i
                                </a>
                            </li>
                        }
                        <li class="page-item @(ViewBag.PaginaActual >= ViewBag.TotalPaginas ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(ViewBag.PaginaActual + 1)"
                               asp-route-buscar="@ViewBag.Buscar">
                                Siguiente
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
