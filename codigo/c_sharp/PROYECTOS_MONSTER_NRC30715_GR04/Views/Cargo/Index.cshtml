@model List<PROYECTOS_MONSTER_NRC30715_GR04.Models.ViewModels.CargoViewModel>

@{
    ViewData["Title"] = "Cargos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Cargos</h3>
    <a asp-action="Create" class="btn btn-primary">Nuevo Cargo</a>
</div>

<form method="get" asp-action="Index" class="row mb-3">
    <div class="col-md-10">
        <input type="text"
               name="buscar"
               value="@ViewBag.Buscar"
               class="form-control"
               placeholder="Buscar por departamento, código o descripción de cargo..." />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-success w-100">Buscar</button>
    </div>
</form>

<div class="d-flex gap-2 mb-3">
    <a asp-action="ExportarPdf" class="btn btn-danger" title="Descargar reporte en PDF">
        PDF
    </a>
    <a asp-action="ExportarExcel" class="btn btn-success" title="Descargar reporte en Excel">
        Excel
    </a>
    <a asp-action="ExportarCsv" class="btn btn-secondary" title="Descargar reporte en CSV">
        CSV
    </a>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Departamento</th>
            <th>Código de Cargo</th>
            <th>Descripción</th>
            <th width="220">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center">No existen registros.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.DepartamentoDescripcion</td>
                    <td>@item.Codigo</td>
                    <td>@item.Descripcion</td>
                    <td>
                        <a asp-action="Details" asp-route-dep="@item.DepartamentoCodigo" asp-route-cod="@item.Codigo" class="btn btn-info btn-sm">Ver</a>
                        <a asp-action="Edit" asp-route-dep="@item.DepartamentoCodigo" asp-route-cod="@item.Codigo" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Delete" asp-route-dep="@item.DepartamentoCodigo" asp-route-cod="@item.Codigo" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (ViewBag.TotalPaginas > 1)
{
    <nav aria-label="Paginación de cargos">
        <ul class="pagination justify-content-center">
            <!-- Anterior -->
            <li class="page-item @(ViewBag.PaginaActual <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaActual - 1)"
                   asp-route-buscar="@ViewBag.Buscar">
                    Anterior
                </a>
            </li>

            <!-- Números de página -->
            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                <li class="page-item @(ViewBag.PaginaActual == i ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pagina="@i"
                       asp-route-buscar="@ViewBag.Buscar">
                        @i
                    </a>
                </li>
            }

            <!-- Siguiente -->
            <li class="page-item @(ViewBag.PaginaActual >= ViewBag.TotalPaginas ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaActual + 1)"
                   asp-route-buscar="@ViewBag.Buscar">
                    Siguiente
                </a>
            </li>
        </ul>
        <div class="text-center text-muted">
            Página @ViewBag.PaginaActual de @ViewBag.TotalPaginas
        </div>
    </nav>
}
