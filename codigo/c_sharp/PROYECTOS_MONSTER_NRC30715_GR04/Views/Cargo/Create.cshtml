@model PROYECTOS_MONSTER_NRC30715_GR04.Models.ViewModels.CargoViewModel

@{
    ViewData["Title"] = "Nuevo Cargo";
}

<h3 class="mb-4">Nuevo Cargo</h3>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DepartamentoCodigo" class="form-label"></label>
                    <select asp-for="DepartamentoCodigo" asp-items="Model.Departamentos" class="form-select">
                        <option value="">Seleccione Departamento</option>
                    </select>
                    <span asp-validation-for="DepartamentoCodigo" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Codigo" class="form-label"></label>
                    <input asp-for="Codigo" class="form-control" placeholder="Ej. C02" required maxlength="3" />
                    <span asp-validation-for="Codigo" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-12 mb-3">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <input asp-for="Descripcion" class="form-control" placeholder="Ej. Desarrollador Web Senior" required maxlength="50" />
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div>
        <button type="submit" class="btn btn-success">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
