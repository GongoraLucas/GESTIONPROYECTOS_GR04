@model PROYECTOS_MONSTER_NRC30715_GR04.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    <div class="row mb-4">

        <div class="col">

            <h2>Bienvenido @User.Identity?.Name</h2>
            <p class="text-muted">Sistema de Gestión de Proyectos Monster</p>
            <hr />

        </div>

    </div>

    <div class="row g-4">

        @if (User.HasClaim(c => c.Type == "OPCION" && c.Value == "EMP"))
        {
            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">Empleados</h5>
                        <p class="card-text">Administración de empleados del sistema.</p>
                        <p class="mt-2"><strong>Total:</strong> @Model.TotalEmpleados</p>
                    </div>
                </div>
            </div>
        }

        @if (User.HasClaim(c => c.Type == "OPCION" && c.Value == "USR"))
        {
            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">Usuarios</h5>
                        <p class="card-text">Gestión de accesos y credenciales.</p>
                        <p class="mt-2"><strong>Total:</strong> @Model.TotalUsuarios</p>
                    </div>
                </div>
            </div>
        }

        @if (User.HasClaim(c => c.Type == "OPCION" && c.Value == "PRO"))
        {
            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">Proyectos</h5>
                        <p class="card-text">Administración de proyectos y equipos.</p>
                    </div>
                </div>
            </div>
        }

        @if (User.HasClaim(c => c.Type == "OPCION" && c.Value == "REP"))
        {
            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">Reportes</h5>
                        <p class="card-text">Consulta y generación de reportes.</p>
                    </div>
                </div>
            </div>
        }

    </div>

</div>
