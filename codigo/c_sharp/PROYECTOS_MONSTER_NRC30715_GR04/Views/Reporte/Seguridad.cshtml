@{
    ViewData["Title"] = "Reportes de Seguridad";
}

<div class="mb-4">
    <h3 class="fw-bold text-dark m-0">Centro de Reportes: Seguridad</h3>
    <p class="text-muted small">Generación y exportación de información sobre accesos, perfiles e ingresos del sistema.</p>
</div>

<div class="row g-4">
    <!-- Usuarios Card -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0 rounded-4 transition-card">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-3 fs-4">
                            <i class="bi bi-person-gear"></i>
                        </div>
                        <h5 class="fw-bold m-0">Usuarios del Sistema</h5>
                    </div>
                    <p class="text-muted small">Listado de usuarios del sistema con su correspondiente login, correo electrónico, estado de cuenta y relación de empleado.</p>
                </div>
                <div class="d-flex gap-2 mt-4 pt-3 border-top">
                    <a asp-action="DescargarUsuarioPdf" class="btn btn-sm btn-outline-danger flex-grow-1 d-flex align-items-center justify-content-center gap-1">
                        <i class="bi bi-file-earmark-pdf-fill"></i> PDF
                    </a>
                    <a asp-action="DescargarUsuarioExcel" class="btn btn-sm btn-outline-success flex-grow-1 d-flex align-items-center justify-content-center gap-1">
                        <i class="bi bi-file-earmark-excel-fill"></i> Excel
                    </a>
                    <a asp-action="DescargarUsuarioCsv" class="btn btn-sm btn-outline-secondary flex-grow-1 d-flex align-items-center justify-content-center gap-1">
                        <i class="bi bi-filetype-csv"></i> CSV
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .transition-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .transition-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
    }
</style>
