@model List<PROYECTOS_MONSTER_NRC30715_GR04.Models.ViewModels.EmpleadoViewModel>

@{
    ViewData["Title"] = "Empleados";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <h3>Empleados</h3>

    <a asp-action="Create"
       class="btn btn-primary">

        Nuevo Empleado

    </a>

</div>

<form method="get"
      asp-action="Index"
      class="row mb-3">

    <div class="col-md-10">

        <input type="text"
               name="buscar"
               value="@Context.Request.Query["buscar"]"
               class="form-control"
               placeholder="Buscar por código, cédula, nombre o apellido..." />

    </div>

    <div class="col-md-2">

        <button type="submit"
                class="btn btn-success w-100">

            Buscar

        </button>

    </div>

</form>

@* Botones de exportación *@
<div class="d-flex gap-2 mb-3">

    <a asp-action="ExportarPdf"
       class="btn btn-danger"
       title="Descargar reporte en PDF">
        <i class="bi bi-file-earmark-pdf-fill"></i> PDF
    </a>

    <a asp-action="ExportarExcel"
       class="btn btn-success"
       title="Descargar reporte en Excel">
        <i class="bi bi-file-earmark-excel-fill"></i> Excel
    </a>

    <a asp-action="ExportarCsv"
       class="btn btn-secondary"
       title="Descargar reporte en CSV">
        <i class="bi bi-filetype-csv"></i> CSV
    </a>

</div>

<table class="table table-bordered table-hover align-middle">

    <thead class="table-dark">

        <tr>
            <th>Foto</th>
            <th>Código</th>
            <th>Cédula</th>
            <th>Apellidos</th>
            <th>Nombres</th>
            <th>Email</th>
            <th>Teléfono</th>
            <th width="220">Acciones</th>
        </tr>

    </thead>

    <tbody>

        @if (!Model.Any())
        {
            <tr>

                <td colspan="8"
                    class="text-center">

                    No existen registros.

                </td>

            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>

                    <td>

                        @if (!string.IsNullOrEmpty(item.Foto))
                        {
                            <img src="@item.Foto"
                                 width="60"
                                 height="60"
                                 class="rounded-circle"
                                 style="object-fit:cover;" />
                        }
                        else
                        {
                            <img src="/images/no-image.png"
                                 width="60"
                                 height="60"
                                 class="rounded-circle"
                                 style="object-fit:cover;" />
                        }

                    </td>

                    <td>@item.Codigo</td>

                    <td>@item.Cedula</td>

                    <td>@item.Apellidos</td>

                    <td>@item.Nombres</td>

                    <td>@item.Email</td>

                    <td>@item.Telefono</td>

                    <td>

                        <a asp-action="Details"
                           asp-route-id="@item.Codigo"
                           class="btn btn-info btn-sm">

                            Ver

                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.Codigo"
                           class="btn btn-warning btn-sm">

                            Editar

                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Codigo"
                           class="btn btn-danger btn-sm">

                            Eliminar

                        </a>

                    </td>

                </tr>
            }
        }

    </tbody>

</table>

@if (ViewBag.TotalPaginas > 1)
{
    <nav aria-label="Paginación de empleados">

        <ul class="pagination justify-content-center">

            <!-- Anterior -->
            <li class="page-item @(ViewBag.Pagina <= 1 ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@(ViewBag.Pagina - 1)"
                   asp-route-buscar="@ViewBag.Buscar">

                    Anterior

                </a>

            </li>

            <!-- Números de página -->
            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                <li class="page-item @(ViewBag.Pagina == i ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pagina="@i"
                       asp-route-buscar="@ViewBag.Buscar">

                        @i

                    </a>

                </li>
            }

            <!-- Siguiente -->
            <li class="page-item @(ViewBag.Pagina >= ViewBag.TotalPaginas ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@(ViewBag.Pagina + 1)"
                   asp-route-buscar="@ViewBag.Buscar">

                    Siguiente

                </a>

            </li>

        </ul>

        <div class="text-center text-muted">

            Página @ViewBag.Pagina de @ViewBag.TotalPaginas

        </div>

    </nav>
}