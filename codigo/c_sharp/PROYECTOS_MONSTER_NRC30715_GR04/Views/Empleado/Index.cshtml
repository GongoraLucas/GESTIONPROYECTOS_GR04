@model List<PROYECTOS_MONSTER_NRC30715_GR04.Models.ViewModels.EmpleadoViewModel>

@{
    ViewData["Title"] = "Empleados";
}

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-4">
        <!-- Header area inside card -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h3 class="fw-bold text-dark m-0">Empleados</h3>
                <p class="text-muted small m-0">Gestión de personal de la organización</p>
            </div>
            <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-plus-lg"></i> Nuevo Empleado
            </a>
        </div>

        <!-- Search / Filter area -->
        <form method="get" asp-action="Index" class="row g-3 mb-4">
            <div class="col-md-9 col-lg-10">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           name="buscar"
                           value="@Context.Request.Query["buscar"]"
                           class="form-control bg-light border-start-0 ps-0"
                           placeholder="Buscar por código, cédula, nombre o apellido..." />
                </div>
            </div>
            <div class="col-md-3 col-lg-2">
                <button type="submit" class="btn btn-dark w-100 shadow-sm">
                    <i class="bi bi-funnel-fill me-1"></i> Filtrar
                </button>
            </div>
        </form>

        <!-- Quick actions / Export button group -->
        <div class="d-flex align-items-center justify-content-between border-top border-bottom py-3 mb-4">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small fw-semibold me-2">Exportar:</span>
                <a asp-action="ExportarPdf" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 shadow-xs" title="Exportar a PDF">
                    <i class="bi bi-file-earmark-pdf-fill"></i> PDF
                </a>
                <a asp-action="ExportarExcel" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1 shadow-xs" title="Exportar a Excel">
                    <i class="bi bi-file-earmark-excel-fill"></i> Excel
                </a>
                <a asp-action="ExportarCsv" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-xs" title="Exportar a CSV">
                    <i class="bi bi-filetype-csv"></i> CSV
                </a>
            </div>
            <div class="text-muted small">
                Total: <strong>@(ViewBag.TotalRegistros ?? Model.Count)</strong> registros
            </div>
        </div>

        <!-- Table view with styled classes -->
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-3">Foto</th>
                        <th>Código</th>
                        <th>Cédula</th>
                        <th>Apellidos</th>
                        <th>Nombres</th>
                        <th>Email</th>
                        <th>Teléfono</th>
                        <th class="text-end pe-3" width="200">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
                                No se encontraron registros.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    @if (!string.IsNullOrEmpty(item.Foto))
                                    {
                                        <img src="@item.Foto"
                                             width="45"
                                             height="45"
                                             class="rounded-circle shadow-xs border border-2 border-white"
                                             style="object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <img src="/images/no-image.png"
                                             width="45"
                                             height="45"
                                             class="rounded-circle shadow-xs border border-2 border-white"
                                             style="object-fit:cover;" />
                                    }
                                </td>
                                <td class="fw-semibold text-secondary">@item.Codigo</td>
                                <td>@item.Cedula</td>
                                <td class="fw-semibold">@item.Apellidos</td>
                                <td>@item.Nombres</td>
                                <td class="text-muted">@item.Email</td>
                                <td>@item.Telefono</td>
                                <td class="text-end pe-3">
                                    <div class="btn-group gap-1">
                                        <a asp-action="Details"
                                           asp-route-id="@item.Codigo"
                                           class="btn btn-sm btn-outline-info d-inline-flex align-items-center justify-content-center"
                                           style="width: 32px; height: 32px; border-radius: 6px;"
                                           title="Ver Detalle">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Codigo"
                                           class="btn btn-sm btn-outline-warning d-inline-flex align-items-center justify-content-center"
                                           style="width: 32px; height: 32px; border-radius: 6px;"
                                           title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Codigo"
                                           class="btn btn-sm btn-outline-danger d-inline-flex align-items-center justify-content-center"
                                           style="width: 32px; height: 32px; border-radius: 6px;"
                                           title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPaginas > 1)
        {
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center border-top pt-4 mt-3 gap-2">
                <div class="text-muted small">
                    Página <strong>@ViewBag.PaginaActual</strong> de <strong>@ViewBag.TotalPaginas</strong>
                </div>
                <nav aria-label="Paginación de empleados">
                    <ul class="pagination pagination-sm m-0">
                        <li class="page-item @(ViewBag.PaginaActual <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(ViewBag.PaginaActual - 1)"
                               asp-route-buscar="@ViewBag.Buscar">
                                Anterior
                            </a>
                        </li>
                        @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                        {
                            <li class="page-item @(ViewBag.PaginaActual == i ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pagina="@i"
                                   asp-route-buscar="@ViewBag.Buscar">
                                    @i
                                </a>
                            </li>
                        }
                        <li class="page-item @(ViewBag.PaginaActual >= ViewBag.TotalPaginas ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(ViewBag.PaginaActual + 1)"
                               asp-route-buscar="@ViewBag.Buscar">
                                Siguiente
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>