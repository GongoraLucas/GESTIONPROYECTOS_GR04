@model PROYECTOS_MONSTER_NRC30715_GR04.Models.ViewModels.EmpleadoViewModel

@{
    ViewData["Title"] = "Detalle Empleado";
}

<h3 class="mb-4">
    Detalle Empleado
</h3>

<div class="card">

    <div class="card-body">

        <div class="row">

            <div class="col-md-3 text-center">

                @if (!string.IsNullOrEmpty(Model.Foto))
                {
                    <img src="@Model.Foto"
                         class="img-thumbnail"
                         style="width:220px;height:220px;object-fit:cover;" />
                }
                else
                {
                    <img src="/images/no-image.png"
                         class="img-thumbnail"
                         style="width:220px;height:220px;object-fit:cover;" />
                }

            </div>

            <div class="col-md-9">

                <table class="table table-bordered">

                    <tr>
                        <th>Código</th>
                        <td>@Model.Codigo</td>
                    </tr>

                    <tr>
                        <th>Cédula</th>
                        <td>@Model.Cedula</td>
                    </tr>

                    <tr>
                        <th>Apellidos</th>
                        <td>@Model.Apellidos</td>
                    </tr>

                    <tr>
                        <th>Nombres</th>
                        <td>@Model.Nombres</td>
                    </tr>

                    <tr>
                        <th>Sexo</th>
                        <td>@Model.SexoDescripcion</td>
                    </tr>

                    <tr>
                        <th>Estado Civil</th>
                        <td>@Model.EstadoCivilDescripcion</td>
                    </tr>

                    <tr>
                        <th>Departamento/Cargo</th>
                        <td>@Model.CargoDescripcion</td>
                    </tr>

                    <tr>
                        <th>Jefe</th>
                        <td>@Model.JefeNombre</td>
                    </tr>

                    <tr>
                        <th>Teléfono</th>
                        <td>@Model.Telefono</td>
                    </tr>

                    <tr>
                        <th>Email</th>
                        <td>@Model.Email</td>
                    </tr>

                    <tr>
                        <th>Dirección</th>
                        <td>@Model.Direccion</td>
                    </tr>

                    <tr>
                        <th>Salario</th>
                        <td>
                            @Model.Salario.ToString("C")
                        </td>
                    </tr>

                </table>

            </div>

        </div>

    </div>

</div>

<div class="mt-3">

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>

</div>