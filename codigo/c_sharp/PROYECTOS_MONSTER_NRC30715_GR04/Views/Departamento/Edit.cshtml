@model PROYECTOS_MONSTER_NRC30715_GR04.Models.ViewModels.DepartamentoViewModel

@{
    ViewData["Title"] = "Editar Departamento";
}

<h3 class="mb-4">Editar Departamento</h3>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Codigo" class="form-label"></label>
                    <input asp-for="Codigo" class="form-control" readonly />
                    <span asp-validation-for="Codigo" class="text-danger"></span>
                </div>
                <div class="col-md-8 mb-3">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <input asp-for="Descripcion" class="form-control" maxlength="50" />
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div>
        <button type="submit" class="btn btn-success">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
