@model PROYECTOS_MONSTER_NRC30715_GR04.Models.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-5">

            <div class="card shadow">

                <div class="card-header text-center">
                    <h3>Nueva Contraseña</h3>
                </div>

                <div class="card-body">

                    <form asp-action="ResetPassword"
                          method="post">

                        <input asp-for="Token"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="PasswordNueva"
                                   class="form-label">
                            </label>

                            <input asp-for="PasswordNueva"
                                   class="form-control" />

                            <span asp-validation-for="PasswordNueva"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="ConfirmarPassword"
                                   class="form-label">
                            </label>

                            <input asp-for="ConfirmarPassword"
                                   class="form-control" />

                            <span asp-validation-for="ConfirmarPassword"
                                  class="text-danger">
                            </span>

                        </div>

                        <button type="submit"
                                class="btn btn-success w-100">
                            Guardar Contraseña
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}