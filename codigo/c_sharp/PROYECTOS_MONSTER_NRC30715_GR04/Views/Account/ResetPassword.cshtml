@model PROYECTOS_MONSTER_NRC30715_GR04.Models.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="text-center mb-3">
    <h4 class="fw-semibold text-dark">Nueva Contraseña</h4>
    <p class="text-muted small">Establezca una nueva contraseña segura para su cuenta.</p>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form asp-action="ResetPassword" method="post">
    <input asp-for="Token" type="hidden" />

    <div class="mb-3">
        <label asp-for="PasswordNueva" class="form-label fw-semibold text-secondary">Nueva Contraseña</label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted">
                <i class="bi bi-shield-lock-fill"></i>
            </span>
            <input asp-for="PasswordNueva" type="password" class="form-control bg-light border-start-0 ps-0" placeholder="Mínimo 6 caracteres" required />
        </div>
        <span asp-validation-for="PasswordNueva" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmarPassword" class="form-label fw-semibold text-secondary">Confirmar Contraseña</label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted">
                <i class="bi bi-shield-lock-fill"></i>
            </span>
            <input asp-for="ConfirmarPassword" type="password" class="form-control bg-light border-start-0 ps-0" placeholder="Repita su contraseña" required />
        </div>
        <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-success w-100 py-2 fw-semibold shadow-sm mt-3">
        Guardar Contraseña
    </button>
</form>

<hr class="text-muted my-4" />

<div class="text-center">
    <a asp-action="Login" class="text-decoration-none small fw-semibold text-primary">
        <i class="bi bi-arrow-left me-1"></i> Cancelar y volver
    </a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}