@model PROYECTOS_MONSTER_NRC30715_GR04.Models.ViewModels.RecuperarPasswordViewModel

@{
    ViewData["Title"] = "Recuperar Contraseña";
}

<div class="text-center mb-3">
    <h4 class="fw-semibold text-dark">Recuperar Contraseña</h4>
    <p class="text-muted small">Ingrese su correo electrónico para recibir un token de acceso temporal.</p>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form asp-action="RecuperarPassword" method="post">
    <div class="mb-3">
        <label asp-for="Email" class="form-label fw-semibold text-secondary">Correo Electrónico</label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted">
                <i class="bi bi-envelope-fill"></i>
            </span>
            <input asp-for="Email" class="form-control bg-light border-start-0 ps-0" placeholder="correo@ejemplo.com" required />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm mt-3">
        Generar Token
    </button>
</form>

<hr class="text-muted my-4" />

<div class="text-center">
    <a asp-action="Login" class="text-decoration-none small fw-semibold text-primary">
        <i class="bi bi-arrow-left me-1"></i> Volver al Inicio de Sesión
    </a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}