@{
    ViewData["Title"] = "Token Generado";
}

<div class="text-center">
    <div class="mb-3">
        <i class="bi bi-envelope-check-fill text-success fs-1"></i>
    </div>
    <h4 class="fw-semibold text-dark">Recuperación de Contraseña</h4>
    <p class="text-muted mt-3">Se generó correctamente el token de recuperación y se envió por correo electrónico.</p>
    <p class="text-muted small">Por favor, revise su bandeja de entrada y haga clic en el enlace recibido para restablecer su contraseña.</p>
    
    <hr class="text-muted my-4" />
    
    <a asp-action="Login" class="btn btn-outline-primary w-100 py-2 fw-semibold">
        Volver al Inicio
    </a>
</div>