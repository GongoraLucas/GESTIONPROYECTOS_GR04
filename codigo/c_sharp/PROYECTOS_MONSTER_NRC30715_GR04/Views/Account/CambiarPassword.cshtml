@model PROYECTOS_MONSTER_NRC30715_GR04.Models.ViewModels.CambiarPasswordViewModel

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card">

                <div class="card-header">
                    Cambiar Contraseña
                </div>

                <div class="card-body">

                    <div class="alert alert-warning">

                        Debe cambiar su contraseña para continuar utilizando el sistema.

                    </div>

                    <form asp-action="CambiarPassword"
                          method="post">

                        <div asp-validation-summary="All"
                             class="text-danger">
                        </div>

                        <div class="mb-3">

                            <label asp-for="PasswordActual"></label>

                            <input asp-for="PasswordActual"
                                   class="form-control" />

                        </div>

                        <div class="mb-3">

                            <label asp-for="PasswordNueva"></label>

                            <input asp-for="PasswordNueva"
                                   class="form-control" />

                        </div>

                        <div class="mb-3">

                            <label asp-for="ConfirmarPassword"></label>

                            <input asp-for="ConfirmarPassword"
                                   class="form-control" />

                        </div>

                        <button type="submit"
                                class="btn btn-primary">
                            Guardar
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}